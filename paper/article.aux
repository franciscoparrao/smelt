\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces  Case study results on King County housing (1{,}000 samples, 11 features, log-price target).}}{6}{table.2}\protected@file@percent }
\newlabel{tab:casestudy}{{2}{6}{Case study results on King County housing (1{,}000 samples, 11 features, log-price target)}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces  Split-conformal prediction intervals computed over the \emph  {spatial} predictions (King County, log-price, projected UTM coordinates; 60\% fit / 20\% calibration / 20\% test, $n_\text  {test} = 200$, seed 42; bandwidth 50 selected by the Eq.~11 leave-one-out criterion over candidates $\geq 30$; local/global blend $\alpha _{\mathrm  {geo}} = 0.5$). The calibration set's absolute residuals give the half-width $q$ at each nominal level, so $\hat  y \pm q$ carries a finite-sample coverage guarantee for either model. Coverage lands on the nominal level for both (the guarantee, which is model-agnostic); at equal guaranteed coverage, Geo-{\fontseries  {m}\fontseries  {b}\selectfont  XGBoost}'s better local point accuracy (test RMSE 0.264 vs.\ 0.351) yields intervals 16--25\% narrower than the non-spatial baseline. The conformal step is $\approx 5$ lines of \textsf  {numpy} (replication script \bgroup \catcode `\_12\relax \catcode `\~12\relax \catcode `\$12\relax {\normalfont  \ttfamily  \hyphenchar \font =-1 conformal\_intervals.py}\egroup ), so the rule is directly verifiable.}}{7}{table.3}\protected@file@percent }
\newlabel{tab:conformal}{{3}{7}{Split-conformal prediction intervals computed over the \emph {spatial} predictions (King County, log-price, projected UTM coordinates; 60\% fit / 20\% calibration / 20\% test, $n_\text {test} = 200$, seed 42; bandwidth 50 selected by the Eq.~11 leave-one-out criterion over candidates $\geq 30$; local/global blend $\alpha _{\mathrm {geo}} = 0.5$). The calibration set's absolute residuals give the half-width $q$ at each nominal level, so $\hat y \pm q$ carries a finite-sample coverage guarantee for either model. Coverage lands on the nominal level for both (the guarantee, which is model-agnostic); at equal guaranteed coverage, Geo-\pkg {XGBoost}'s better local point accuracy (test RMSE 0.264 vs.\ 0.351) yields intervals 16--25\% narrower than the non-spatial baseline. The conformal step is $\approx 5$ lines of \proglang {numpy} (replication script \code {conformal\_intervals.py}), so the rule is directly verifiable}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces  Validation of {\fontseries  {m}\fontseries  {b}\selectfont  smelt-ml}'s Geographical-{\fontseries  {m}\fontseries  {b}\selectfont  XGBoost} against the original \textsf  {Python} implementation ({\fontseries  {m}\fontseries  {b}\selectfont  geoxgboost}~1.1.1) on King County housing (holdout, 800 train / 200 test, 11 features, log-price, seed 42), with a local/global blend $\alpha _{\mathrm  {geo}} = 0.5$, bandwidth 30 adaptive, 100 trees, depth 6, learning rate 0.3. The two Geo-{\fontseries  {m}\fontseries  {b}\selectfont  XGBoost} implementations agree to $\Delta \text  {RMSE} = 0.008$ and $\Delta $R$^2 = 0.014$; the small residual reflects the differing underlying {\fontseries  {m}\fontseries  {b}\selectfont  XGBoost} engines (pure \textsf  {Rust} vs.\ official \textsf  {C++}), a gap already visible in the non-spatial baselines. Training time is not compared here: {\fontseries  {m}\fontseries  {b}\selectfont  geoxgboost} performs an internal 5-fold nested cross-validation per local model that {\fontseries  {m}\fontseries  {b}\selectfont  smelt-ml} does not, so the two are not like-for-like; controlled timing benchmarks appear in Section~\ref {sec:performance}.}}{7}{table.4}\protected@file@percent }
\newlabel{tab:geoxgb_validation}{{4}{7}{Validation of \pkg {smelt-ml}'s Geographical-\pkg {XGBoost} against the original \proglang {Python} implementation (\pkg {geoxgboost}~1.1.1) on King County housing (holdout, 800 train / 200 test, 11 features, log-price, seed 42), with a local/global blend $\alpha _{\mathrm {geo}} = 0.5$, bandwidth 30 adaptive, 100 trees, depth 6, learning rate 0.3. The two Geo-\pkg {XGBoost} implementations agree to $\Delta \text {RMSE} = 0.008$ and $\Delta $R$^2 = 0.014$; the small residual reflects the differing underlying \pkg {XGBoost} engines (pure \proglang {Rust} vs.\ official \proglang {C++}), a gap already visible in the non-spatial baselines. Training time is not compared here: \pkg {geoxgboost} performs an internal 5-fold nested cross-validation per local model that \pkg {smelt-ml} does not, so the two are not like-for-like; controlled timing benchmarks appear in Section~\ref {sec:performance}}{table.4}{}}
