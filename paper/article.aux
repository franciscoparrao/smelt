\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Training time scaling comparison (log-log) between {\fontseries  {m}\fontseries  {b}\selectfont  smelt-ml} (blue) and official \textsf  {C++} libraries (red) across six dataset sizes. Error bars show $\pm $1 standard deviation over 10 runs. {\fontseries  {m}\fontseries  {b}\selectfont  smelt-ml}'s {\fontseries  {m}\fontseries  {b}\selectfont  CatBoost} is competitive at all scales; {\fontseries  {m}\fontseries  {b}\selectfont  XGBoost} and {\fontseries  {m}\fontseries  {b}\selectfont  LightGBM} are faster in \textsf  {C++} at $n \geq 50{,}000$.}}{15}{figure.1}\protected@file@percent }
\newlabel{fig:scaling}{{1}{15}{Training time scaling comparison (log-log) between \pkg {smelt-ml} (blue) and official \proglang {C++} libraries (red) across six dataset sizes. Error bars show $\pm $1 standard deviation over 10 runs. \pkg {smelt-ml}'s \pkg {CatBoost} is competitive at all scales; \pkg {XGBoost} and \pkg {LightGBM} are faster in \proglang {C++} at $n \geq 50{,}000$}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces  Statistical significance of performance differences (Wilcoxon signed-rank, paired, two-sided). Selected rows shown. $^{*}p < 0.05$, $^{**}p < 0.01$. Bootstrap 95\% CI for the speedup ratio ($>1$ = Rust faster). {\fontseries  {m}\fontseries  {b}\selectfont  CatBoost} classification is significantly faster at 5 of 6 sizes.}}{16}{table.11}\protected@file@percent }
\newlabel{tab:significance}{{11}{16}{Statistical significance of performance differences (Wilcoxon signed-rank, paired, two-sided). Selected rows shown. $^{*}p < 0.05$, $^{**}p < 0.01$. Bootstrap 95\% CI for the speedup ratio ($>1$ = Rust faster). \pkg {CatBoost} classification is significantly faster at 5 of 6 sizes}{table.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces  Prediction time for 1{,}000 samples (100 runs, classification). {\fontseries  {m}\fontseries  {b}\selectfont  smelt-ml} is 3.6--3.7$\times $ faster for ensemble methods due to parallel tree traversal and absence of \textsf  {Python} interpreter overhead.}}{16}{table.12}\protected@file@percent }
\newlabel{tab:predict}{{12}{16}{Prediction time for 1{,}000 samples (100 runs, classification). \pkg {smelt-ml} is 3.6--3.7$\times $ faster for ensemble methods due to parallel tree traversal and absence of \proglang {Python} interpreter overhead}{table.12}{}}
